menu "DAJILOG Configuration"
    menu "Applications"
        config DAJILOG_APP_HELLO
            bool "Hello Test app"
            default y

        config DAJILOG_APP_WIFI
            bool "Wi-Fi app"
            default y

        config DAJILOG_APP_EEZ_DEMO
            bool "5-inch EEZ portrait main app"
            default y
            help
                Build the 720x1280 EEZ Studio application stored under this
                board target. This application is not shared with the 7B.

        choice DAJILOG_FIRMWARE_UPDATE_METHOD
            prompt "Firmware update method"
            default DAJILOG_UPDATE_USB_MEMORY

            config DAJILOG_UPDATE_DISABLED
                bool "Disabled"
            config DAJILOG_UPDATE_PC_USB
                bool "PC USB Update (USB Device)"
            config DAJILOG_UPDATE_USB_MEMORY
                bool "USB Memory Update (USB Host)"
        endchoice
    endmenu

    menu "Diagnostics"
        config DAJILOG_SETTINGS_DEBUG_LOG
            bool "Print settings values in debug logs"
            default n
            help
                Print staged and saved setting values. Validation and storage
                errors are still logged when this option is disabled.

        config DAJILOG_CAN_DEBUG_LOG
            bool
            default n
    endmenu

    config DAJILOG_CAN_ENABLE
        bool
        default n

    config DAJILOG_CAN_TX_GPIO
        int
        default -1

    config DAJILOG_CAN_RX_GPIO
        int
        default -1

    config DAJILOG_CAN_TRANSCEIVER_ENABLE_GPIO
        int
        default -1
endmenu
