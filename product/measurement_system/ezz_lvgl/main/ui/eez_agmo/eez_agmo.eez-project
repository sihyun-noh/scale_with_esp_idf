        {
          "objID": "89021543-04f2-4134-b127-3a589c596bdf",
          "type": "SetVariableActionComponent",
          "left": 829,
          "top": -249,
          "width": 403,
          "height": 86,
          "customInputs": [
            {
              "objID": "ed362ad1-86ba-4d52-c6f9-9e46db7664db",
              "name": "digit",
              "type": "string"
            }
          ],
          "customOutputs": [],
          "description": "Append digit",
          "entries": [
            {
              "objID": "63b18ee4-3fd3-4ddf-bcdd-ab427deac31e",
              "variable": "display",
              "value": "newNumber ? digit :\n(display == \"0\" ? digit : display + digit)"
            },
            {
              "objID": "1f6cf425-2fbf-4df5-979d-a174ca69dd37",
              "variable": "newNumber",
              "value": "false"
            }
          ]
        },
        {
          "objID": "7709ced0-11d9-406b-cd70-e556d9f68335",
          "type": "SetVariableActionComponent",
          "left": 540,
          "top": 855,
          "width": 134,
          "height": 57,
          "customInputs": [],
          "customOutputs": [],
          "description": "Set operator to +",
          "entries": [
            {
              "objID": "8eb46acd-56f8-4fe1-c434-094214d98c17",
              "variable": "operator",
              "value": "\"+\""
            }
          ]
        },
        {
          "objID": "039e730d-1507-4777-d423-b2239be0b741",
          "type": "SetVariableActionComponent",
          "left": 542,
          "top": 750,
          "width": 134,
          "height": 57,
          "customInputs": [],
          "customOutputs": [],
          "description": "Set operator to -",
          "entries": [
            {
              "objID": "1e99b36c-1b29-4d3f-ebcc-503710431714",
              "variable": "operator",
              "value": "\"-\""
            }
          ]
        },
        {
          "objID": "2d76e208-28e0-4a2c-b304-63abba924241",
          "type": "SetVariableActionComponent",
          "left": 542,
          "top": 645,
          "width": 134,
          "height": 57,
          "customInputs": [],
          "customOutputs": [],
          "description": "Set operator to *",
          "entries": [
            {
              "objID": "7e3b4434-9aa9-4a34-db0e-337fe1342adc",
              "variable": "operator",
              "value": "\"*\""
            }
          ]
        },
        {
          "objID": "90eea293-0172-456b-c6b8-93a193577afe",
          "type": "SetVariableActionComponent",
          "left": 542,
          "top": 540,
          "width": 134,
          "height": 57,
          "customInputs": [],
          "customOutputs": [],
          "description": "Set operator to /",
          "entries": [
            {
              "objID": "ac580fcb-3900-40aa-aa08-997aed786833",
              "variable": "operator",
              "value": "\"/\""
            }
          ]
        },
        {
          "objID": "0b29ea95-36a1-4ec1-cc7a-f16d6e3225a1",
          "type": "SwitchActionComponent",
          "left": -237,
          "top": 589,
          "width": 417,
          "height": 135,
          "customInputs": [],
          "customOutputs": [],
          "description": "Do the operation",
          "tests": [
            {
              "objID": "11d2d78c-b2fd-4884-def1-0ae8b507e47d",
              "condition": "operator == \"+\"",
              "outputName": "ADD",
              "outputValue": "operand + Flow.parseFloat(display)"
            },
            {
              "objID": "a5110054-00c6-48f2-ed25-44351b869021",
              "condition": "operator == \"-\"",
              "outputName": "SUB",
              "outputValue": "operand - Flow.parseFloat(display)"
            },
            {
              "objID": "b1255993-e14e-4d95-dff1-48db0ef4ab93",
              "condition": "operator == \"*\"",
              "outputName": "MUL",
              "outputValue": "operand * Flow.parseFloat(display)"
            },
            {
              "objID": "ec70dadd-347e-4493-d560-ea2744067019",
              "condition": "operator == \"/\"",
              "outputName": "DIV",
              "outputValue": "Flow.parseFloat(display) != 0\n? operand / Flow.parseFloat(display)\n: 0"
            }
          ]
        },
        {
          "objID": "54cd92a5-65e1-4823-b1e5-4a39682d593c",
          "type": "SetVariableActionComponent",
          "left": 276,
          "top": 589,
          "width": 189,
          "height": 100,
          "customInputs": [
            {
              "objID": "6bb2b35a-58fc-4334-a3f0-ad92aee0bfdd",
              "name": "result",
              "type": "float"
            }
          ],
          "customOutputs": [],
          "description": "Display result",
          "entries": [
            {
              "objID": "b34c57f8-7b4c-4af0-e174-7fe651dacc2e",
              "variable": "display",
              "value": "result"
            },
            {
              "objID": "93a58d44-1839-4f15-9585-b833a27f94c0",
              "variable": "newNumber",
              "value": "true"
            },
            {
              "objID": "afa10d2b-61e7-4c60-cdeb-0baa3bcb2f17",
              "variable": "operator",
              "value": "\"\""
            }
          ]
        },
        {
          "objID": "6a4fb4d8-c403-426d-a8a6-eb8aa061af48",
          "type": "SetVariableActionComponent",
          "left": 531,
          "top": -109,
          "width": 828,
          "height": 78,
          "customInputs": [],
          "customOutputs": [],
          "description": "Add decimal point",
          "entries": [
            {
              "objID": "b01f44d3-ed10-480c-96f0-d69b5adf8e79",
              "variable": "display",
              "value": "String.find(display, \".\") == -1 ? display + \".\" : display"
            },
            {
              "objID": "cb6b3433-cb9d-4b76-d3fa-cf64d4023cbc",
              "variable": "calcuation_table_empty",
              "value": "String.find(calcuation_table_empty, \".\") == -1 ? calcuation_table_empty + \".\" : calcuation_table_empty"
            }
          ]
        },
        {
          "objID": "f8271954-c848-4e45-c72a-7d08997f5064",
          "type": "SetVariableActionComponent",
          "left": 34,
          "top": -300,
          "width": 324,
          "height": 100,
          "customInputs": [],
          "customOutputs": [],
          "description": "Negate number",
          "entries": [
            {
              "objID": "9a74d1c3-6812-4ca6-e6c9-a5da0acdfa9b",
              "variable": "display",
              "value": "display == \"0\"\n  ? display\n  : String.find(display, \"-\") == -1\n    ? \"-\" + display\n    : String.substring(display, 1)"
            }
          ]
        },
        {
          "objID": "fbc6d2a8-138e-4818-b0d4-b9bb1282a2b2",
          "type": "SetVariableActionComponent",
          "left": 156,
          "top": -132,
          "width": 293,
          "height": 57,
          "customInputs": [],
          "customOutputs": [],
          "description": "Calculate percentage",
          "entries": [
            {
              "objID": "a7d80788-c712-4281-9fe7-53e2a1e523ed",
              "variable": "display",
              "value": "Flow.parseFloat(display) / 100"
            }
          ]
        },
